#!/bin/sh
#
# §9 rules 1 and 3 — see docs/superpowers/specs/2026-09-04-steward-coordination-design.md
#
#   1. One session owns a worktree.
#   3. Always commit with an explicit pathspec: git commit -F msg -- <path>
#
# 🔴 THIS HOOK NEVER FAILS A COMMIT. `|| true` is deliberate and load bearing: a coordination
#    tool that can wedge a commit gets deleted within the day, and then the rule has no observer
#    at all. CLAUDE.md forbids --no-verify, so the only honest way to keep that promise is to
#    never be worth bypassing.
#
# Runs from the root of whichever checkout is committing. A linked worktree usually has no
# backend/node_modules (10 of 17 on 2026-09-23), so the observer runs through a preload that
# borrows the MAIN checkout's node_modules and .env (backend/scripts/lib/main-checkout-fallback.mjs).
# It used to require backend/node_modules here and skip silently without it — which is how it went
# unheard in most worktrees. With no node_modules anywhere it now says so in one line instead.
# A checkout whose branch predates the preload runs the script plainly, as before.
#
# ⚠ Linked worktrees run the MAIN checkout's copy of this file (their config.worktree sets an
#   absolute core.hooksPath); see CLAUDE.md. Install with:  npm run install:hooks --prefix backend
main_backend="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/../backend"
if [ -d backend/node_modules ] || [ -d "$main_backend/node_modules" ]; then
  pre=backend/scripts/lib/main-checkout-fallback.mjs
  if [ -f "$pre" ]; then
    node --import "./$pre" backend/scripts/steward-precommit.mjs || true
  else
    node backend/scripts/steward-precommit.mjs || true
  fi
else
  echo "  steward: pre-commit observer skipped -- no backend/node_modules here or in the main checkout" >&2
fi
exit 0
