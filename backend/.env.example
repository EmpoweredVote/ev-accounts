NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Optional -- falls back to in-memory cache if not set
REDIS_URL=https://your-redis.upstash.io
# XP service keys — one per feature repo; each key authorizes specific XP source(s)
QUEST_SERVICE_KEY=your-quest-service-key           # source: "validation_quest_completion"
TRIVIA_SERVICE_KEY=your-trivia-service-key         # source: "civic_trivia_championship_score"
ADMIN_SERVICE_KEY=your-admin-service-key           # source: "admin_gift"
ESSENTIALS_SERVICE_KEY=your-essentials-service-key # source: "essentials-rep-lookup"
# Gem service keys — JSON map: { "key-value": ["yellow"] }
# Add an entry here for each feature repo that awards gems
GEMS_SERVICE_KEYS={"your-ctc-gem-key":["yellow"],"your-vq-gem-key":["yellow","red"]}
# Google Cloud API key — used for Places (frontend) and reused server-side for the
# Civic Information API that powers /api/essentials/voter-info (voting locations +
# sample-ballot links via the Voting Information Project). voterInfoService prefers
# GOOGLE_CIVIC_API_KEY and falls back to GOOGLE_MAPS_API_KEY, so setting one is enough.
# The key's project must have the Civic Information API enabled and must NOT be
# restricted to HTTP referrers (server-side calls send no referrer).
GOOGLE_MAPS_API_KEY=your-google-cloud-api-key
# GOOGLE_CIVIC_API_KEY=  # optional: only if you want a dedicated key separate from Maps
# Transactional email — Resend API key for admin notifications
RESEND_API_KEY=re_your-resend-api-key
# WorkOS AuthKit (Supabase Auth -> WorkOS migration, decision 0002).
# Setting WORKOS_CLIENT_ID makes the API accept WorkOS tokens as a second
# issuer. The client id is public. The WorkOS API key (sk_...) is NOT read by
# the server — it is only used by backend/scripts/workos-import-users.ts and
# lives in the Render dashboard / operator shell, never in a committed file.
# WORKOS_CLIENT_ID=client_01...
# Optional custom-domain overrides (defaults derive from the client id):
# WORKOS_ISSUER=https://api.workos.com/user_management/client_01...
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_01...
# Admin email address for access request notifications
ADMIN_EMAIL=admin@empowered.vote
# AUTHKIT_PRIMARY (Supabase -> WorkOS cutover, decision 0002). 'true' makes
# POST /api/auth/signup create the WorkOS user holding the password and a
# passwordless Supabase shadow row. Default 'false' = today's Supabase signup.
# Flip together with the frontends' VITE_AUTHKIT_ONLY.
# AUTHKIT_PRIMARY=false
