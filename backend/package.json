{
  "name": "empowered-accounts-backend",
  "version": "0.1.0",
  "description": "Empowered Accounts backend API — foundational three-tier account infrastructure",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run src scripts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check:migrations": "node scripts/check-migration-numbers.mjs",
    "check:answer-delete-guards": "node scripts/check-answer-delete-guards.mjs",
    "check:answer-delete-guards:list": "node scripts/check-answer-delete-guards.mjs --list",
    "check:occupancy": "node scripts/check-office-occupancy.mjs",
    "check:occupancy:all": "node scripts/check-office-occupancy.mjs --all",
    "check:reachability": "node scripts/check-address-reachability.mjs",
    "check:reachability:verbose": "node scripts/check-address-reachability.mjs --verbose",
    "check:child-county": "node scripts/check-child-county-mapping.mjs",
    "check:child-county:verbose": "node scripts/check-child-county-mapping.mjs --verbose",
    "check:readrank-question-unit": "node scripts/check-readrank-question-unit.mjs",
    "check:readrank-question-unit:verbose": "node scripts/check-readrank-question-unit.mjs --verbose",
    "check:answer-seasons": "node scripts/check-answer-season-consumers.mjs",
    "check:answer-seasons:verbose": "node scripts/check-answer-season-consumers.mjs --verbose",
    "check:stance-sources": "node scripts/check-stance-sources.mjs",
    "check:stance-sources:verbose": "node scripts/check-stance-sources.mjs --verbose",
    "audit:stance-citations": "node scripts/audit-stance-citations.mjs",
    "sweep:fabricated-articles": "node scripts/sweep-fabricated-articles.mjs",
    "audit:district-urls": "node scripts/audit-district-urls.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@aws-sdk/client-sqs": "^3.1015.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/unzipper": "^0.10.11",
    "@upstash/redis": "^1.34.0",
    "adm-zip": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.0.0",
    "iconv-lite": "^0.7.2",
    "jose": "^5.9.0",
    "js-yaml": "^4.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.13.0",
    "playwright": "^1.59.1",
    "shapefile": "^0.6.6",
    "unzipper": "^0.12.5",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/aws-lambda": "^8.10.161",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^14.0.0",
    "node-html-parser": "^7.1.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
