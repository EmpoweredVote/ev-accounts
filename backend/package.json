{
  "name": "empowered-accounts-backend",
  "version": "0.1.0",
  "description": "Empowered Accounts backend API — foundational three-tier account infrastructure",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run src scripts --exclude \"**/ingest-gazetteer-places-counties.test.ts\"",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check:migrations": "node scripts/check-migration-numbers.mjs",
    "check:reservations": "node scripts/check-migration-reservations.mjs",
    "check:deletable": "node scripts/check-worktree-deletable.mjs",
    "install:hooks": "git -C .. config core.hooksPath .githooks",
    "check:answer-delete-guards": "node scripts/check-answer-delete-guards.mjs",
    "check:answer-delete-guards:list": "node scripts/check-answer-delete-guards.mjs --list",
    "check:lens-freshness": "node scripts/check-lens-freshness.mjs",
    "check:occupancy": "node scripts/check-office-occupancy.mjs",
    "check:occupancy:all": "node scripts/check-office-occupancy.mjs --all",
    "check:season-scaffold": "node scripts/check-season-scaffold.mjs",
    "check:reachability": "node scripts/check-address-reachability.mjs",
    "check:reachability:verbose": "node scripts/check-address-reachability.mjs --verbose",
    "check:child-county": "node scripts/check-child-county-mapping.mjs",
    "check:child-county:verbose": "node scripts/check-child-county-mapping.mjs --verbose",
    "check:readrank-question-unit": "node scripts/check-readrank-question-unit.mjs",
    "check:readrank-question-unit:verbose": "node scripts/check-readrank-question-unit.mjs --verbose",
    "check:answer-seasons": "node scripts/check-answer-season-consumers.mjs",
    "check:suppressed-reads": "node scripts/check-suppressed-answer-reads.mjs",
    "check:auth-isolation": "node scripts/check-auth-client-isolation.mjs",
    "check:answer-seasons:verbose": "node scripts/check-answer-season-consumers.mjs --verbose",
    "check:federal-cohort": "node scripts/federal-cohort.mjs --check",
    "cohort:federal": "node scripts/federal-cohort.mjs",
    "leads:congress": "node scripts/congress-sponsorship-leads.mjs",
    "check:season-floor": "node scripts/check-season-corpus-floor.mjs",
    "check:season-floor:verbose": "node scripts/check-season-corpus-floor.mjs --verbose",
    "check:stance-sources": "node scripts/check-stance-sources.mjs",
    "check:stance-sources:verbose": "node scripts/check-stance-sources.mjs --verbose",
    "audit:stance-citations": "node scripts/audit-stance-citations.mjs",
    "sweep:fabricated-articles": "node scripts/sweep-fabricated-articles.mjs",
    "audit:district-urls": "node scripts/audit-district-urls.mjs",
    "steward": "node scripts/steward.mjs",
    "check:ladder-text": "node scripts/check-ladder-text-reads.mjs",
    "check:postgis-guard": "node scripts/check-postgis-spatial-ref-guard.mjs",
    "check:spatial-ref": "node scripts/check-spatial-ref-baseline.mjs"
  },
  "overrides": {
    "qs": "^6.16.0",
    "@humanfs/node": "^0.16.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-sqs": "^3.1120.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.45.0",
    "@types/unzipper": "^0.10.11",
    "@upstash/redis": "^1.38.3",
    "adm-zip": "^0.6.1",
    "cheerio": "^1.2.0",
    "compromise": "^14.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.10",
    "js-yaml": "^5.4.1",
    "link-check": "^5.6.0",
    "linkedom": "^0.18.13",
    "natural": "^8.1.1",
    "node-cron": "^4.6.0",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "rss-parser": "^3.13.0",
    "shapefile": "^0.6.6",
    "unzipper": "^0.12.5",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/aws-lambda": "^8.10.162",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "node-html-parser": "^9.0.2",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
