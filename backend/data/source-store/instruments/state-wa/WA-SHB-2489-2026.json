{
  "id": "WA-SHB-2489-2026",
  "scope": "state:wa",
  "title": "Statewide standards for when local governments may enforce laws regulating use of public space for life-sustaining activities",
  "urls": [
    "https://lawfilesext.leg.wa.gov/biennium/2025-26/Pdf/Bill%20Reports/House/2489%20HBR%20HOUS%2026.pdf"
  ],
  "version": "other",
  "operative_text": "A city or town may not enforce any city or town law that criminalizes, penalizes, or otherwise prohibits a person from engaging in life-sustaining activities on public property unless the city or town can demonstrate that adequate alternative shelter space was available at the time and place of the conduct.",
