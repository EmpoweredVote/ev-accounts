  "scope": "state:tn",
  "title": "HB 2128 (112th General Assembly): AN ACT to amend Tennessee Code Annotated, Title 2, Chapter 2 and Title 2, Chapter 7, relative to election integrity.",
  "urls": [
    "https://legiscan.com/TN/bill/HB2128/2021",
    "https://legiscan.com/TN/rollcall/HB2128/id/1164524",
    "https://legiscan.com/TN/rollcall/HB2128/id/1183466",
