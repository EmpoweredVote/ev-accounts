{
  "id": "TN-SB-125-2013",
  "scope": "state:tn",
  "title": "SB 125 (108th General Assembly): As enacted, specifies that only certain photo identification issued by state of Tennessee or United States may be used as evidence of identification for voting purposes; prohibits use of county or municipal identifications for voting purposes. - Amends TCA Title 2, Chapter 7, Part 1.",
  "urls": [
    "https://legiscan.com/TN/bill/SB0125/2013",
    "https://legiscan.com/TN/rollcall/SB0125/id/241823",
