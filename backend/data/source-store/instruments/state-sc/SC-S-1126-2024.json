{
  "id": "SC-S-1126-2024",
  "scope": "state:sc",
  "title": "S 1126 (125th General Assembly): Constitutional amendment",
  "urls": [
    "https://www.scstatehouse.gov/billsearch.php?billnumbers=1126&session=125&summary=B",
    "https://www.scstatehouse.gov/votehistory.php?KEY=24366",
