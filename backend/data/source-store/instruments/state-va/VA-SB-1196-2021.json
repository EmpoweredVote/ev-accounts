  "title": "Teachers and other licensed school board employees; cultural competency (HB 1904 = Chapter 23; SB 1196 = Chapter 24)",
  "urls": [
    "https://legacylis.virginia.gov/cgi-bin/legp604.exe?212+vot+SC0333SB1196+SB1196",
