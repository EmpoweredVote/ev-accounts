{
  "id": "VA-HB-2387-2023",
  "scope": "state:va",
  "title": "HB2387 (2023 Regular Session): Income tax, state; firearm safety device tax credit.",
  "urls": [
    "https://lis.virginia.gov/cgi-bin/legp604.exe?231+sum+HB2387",
    "https://lis.virginia.gov/cgi-bin/legp604.exe?231+ful+HB2387+hil",
