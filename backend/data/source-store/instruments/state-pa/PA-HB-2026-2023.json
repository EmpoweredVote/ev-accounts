  "title": "HB2026 (2023-2024 Regular Session): In school safety and security, providing for purchase of firearm detection technology.",
  "urls": [
    "https://www.legis.state.pa.us/cfdocs/billinfo/bill_history.cfm?syear=2023&sind=0&body=H&type=B&bn=2026",
