  "title": "HC 17 (2025 Regular Session): Constitution; amend to provide that only U.S. citizens are allowed the opportunity to vote.",
  "urls": [
    "https://billstatus.ls.state.ms.us/2025/pdf/history/HC/HC0017.xml",
    "https://billstatus.ls.state.ms.us/documents/2025/pdf/HC/HC0017PS.pdf",
