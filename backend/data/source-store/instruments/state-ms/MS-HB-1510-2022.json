{
  "id": "MS-HB-1510-2022",
  "scope": "state:ms",
  "title": "HB 1510 (2022 Regular Session): Elections; revise procedures regarding voter roll maintenance.",
  "urls": [
    "https://billstatus.ls.state.ms.us/2022/pdf/history/HB/HB1510.xml",
    "https://billstatus.ls.state.ms.us/documents/2022/pdf/HB/1500-1599/HB1510SG.pdf",
    "https://billstatus.ls.state.ms.us/documents/2022/pdf/HB/1500-1599/HB1510IN.pdf",
    "https://billstatus.ls.state.ms.us/documents/2022/pdf/HB/1500-1599/HB1510PS.pdf",
    "https://billstatus.ls.state.ms.us/documents/2022/pdf/cr/HB1510CR.pdf",
    "https://billstatus.ls.state.ms.us/documents/2022/pdf/sam/HB1510_S_Cmte_Amend_01.pdf"
