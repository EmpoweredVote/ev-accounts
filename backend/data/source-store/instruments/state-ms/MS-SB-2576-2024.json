  "id": "MS-SB-2576-2024",
  "scope": "state:ms",
  "title": "SB 2576 (2024 Regular Session): Voter ID; clarify what constitutes a valid voter ID.",
  "urls": [
    "https://billstatus.ls.state.ms.us/2024/pdf/history/SB/SB2576.xml",
    "https://billstatus.ls.state.ms.us/documents/2024/pdf/SB/2500-2599/SB2576SG.pdf",
    "https://billstatus.ls.state.ms.us/documents/2024/pdf/SB/2500-2599/SB2576IN.pdf",
    "https://billstatus.ls.state.ms.us/documents/2024/pdf/SB/2500-2599/SB2576CS.pdf",
