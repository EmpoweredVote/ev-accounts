  "scope": "state:tx",
  "title": "HB302 (86th Legislature Regular Session): Relating to the carrying, storage, or possession of a firearm or firearm ammunition by certain persons on certain residential or commercial property.",
  "urls": [
    "https://capitol.texas.gov/BillLookup/History.aspx?LegSess=86R&Bill=HB302",
    "https://capitol.texas.gov/tlodocs/86R/billtext/html/HB00302I.htm",
