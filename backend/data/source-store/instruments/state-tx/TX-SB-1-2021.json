{
  "id": "TX-SB-1-2021",
  "scope": "state:tx",
  "title": "S.B. 1, relating to election integrity and security, including by preventing fraud in the conduct of elections in this state; increasing criminal penalties; creating criminal offenses (Election Integrity Protection Act of 2021)",
  "urls": [
    "https://capitol.texas.gov/BillLookup/History.aspx?LegSess=872&Bill=SB1",
