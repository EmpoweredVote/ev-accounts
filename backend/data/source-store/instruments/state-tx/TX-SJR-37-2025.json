  "scope": "state:tx",
  "title": "SJR 37 (89R): Proposing a constitutional amendment clarifying that a voter must be a United States citizen.",
  "urls": [
    "https://capitol.texas.gov/BillLookup/History.aspx?LegSess=89R&Bill=SJR37",
