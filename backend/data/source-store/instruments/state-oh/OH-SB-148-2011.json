{
  "id": "OH-SB-148-2011",
  "scope": "state:oh",
  "title": "SB 148 (2011-2012 (129th General Assembly)): S. B. No. 148: Election Law-revise",
  "urls": [
    "https://www.legislature.ohio.gov/legislation/129/sb148",
    "https://search-prod.lis.state.oh.us/api/v2/general_assembly_129/legislation/sb148/02_PS/pdf/",
