{
  "id": "OH-SB-205-2014",
  "scope": "state:oh",
  "title": "SB 205 (2013-2014 (130th General Assembly)): S. B. No. 205: Absent voter ballots-mailing-revise law/ clarify voter must complete",
  "urls": [
    "https://www.legislature.ohio.gov/legislation/130/sb205",
    "https://search-prod.lis.state.oh.us/api/v2/general_assembly_130/legislation/sb205/05_EN/pdf/",
