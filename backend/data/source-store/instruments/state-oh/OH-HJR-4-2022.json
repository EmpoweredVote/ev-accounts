{
  "id": "OH-HJR-4-2022",
  "scope": "state:oh",
  "title": "HJR 4 (2021-2022 (134th General Assembly)): H. J. R. No. 4: CA: Prohibit local government from allowing non-electors to vote",
  "urls": [
    "https://www.legislature.ohio.gov/legislation/134/hjr4",
    "https://search-prod.lis.state.oh.us/api/v2/general_assembly_134/legislation/hjr4/05_EN/html/",
    "https://search-prod.lis.state.oh.us/api/v2/general_assembly_134/legislation/hjr4/00_IN/html/",
    "https://search-prod.lis.state.oh.us/api/v2/general_assembly_134/legislation/hjr4/01_RH/html/",
    "https://search-prod.lis.state.oh.us/api/v2/general_assembly_134/legislation/hjr4/02_PH/html/",
    "https://search-prod.lis.state.oh.us/api/v2/general_assembly_134/legislation/hjr4/03_RS/html/",
