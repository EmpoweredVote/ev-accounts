    {
      "id": "04e837646547375a213054b6ee6f075852f55b97c95dd0fa9fd624ce40b5ca1f",
      "kind": "own-words",
      "url": "https://augustafreepress.com/news/democrats-decry-republican-efforts-to-block-vote/",
      "date": "2013-02-05",
      "date_precision": "day",
      "passage": "Restricting access to the polls by mandating photo ID does nothing but confuse voters who are used to heading to the polls with their just their voter ID card or previous forms of ID allowed,",
      "note": "Statement quoted in an Augusta Free Press story, issued by her as state party chair, about SB 1256 (photo ID at the polls) and HB 1337 / SB 719 (remove utility bill, bank statement, government check, paycheck from accepted IDs).",
