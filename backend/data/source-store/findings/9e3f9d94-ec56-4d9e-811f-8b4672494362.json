    {
      "id": "cce4328e52090fa65e1e98ddd0b3a7ac5d38a725635094d8f8bf960f7844713f",
      "kind": "own-words",
      "url": "https://giffords.org/press-release/2025/07/giffords-pac-endorses-ghazala-hashmi-for-lieutenant-governor-and-jay-jones-for-attorney-general-in-virginia/",
      "date": "2025-07-02",
      "date_precision": "day",
      "passage": "“Tragically, mass shootings continue to increase, and gun violence is the number one killer of our children, more than accidents or illness,” said Senator Ghazala Hashmi. “I am committed to doing everything I can to stop the proliferation of guns and reduce violence and deaths, and I am proud to earn the endorsement of GIFFORDS PAC in honor of that commitment.”",
      "note": "Statement issued in her name on a gun-safety group's endorsement release; says she is committed to reducing the number of guns and gun deaths.",
      "subjects": [
        "general gun safety statement",
        "fewer guns in circulation"
      ],
      "topic_keys": [
        "gun-policy"
      ],
      "provenance": {
        "fetched_by": "source-collector",
        "fetched_at": "2026-10-30T23:51:59.041Z",
        "method": "webfetch"
      }
    },
    {
      "id": "e8c817a2b7b6d567c5293d07ccc78a71b01e54ca7bcc3e3ef336697744003234",
      "kind": "own-words",
      "url": "https://www.wmra.org/2026-01-22/gun-violence-prevention-advocates-demand-action-in-richmond",
      "date": "2026-01-22",
      "date_precision": "day",
      "passage": "\"And I support the ban on assault weapons, which we know are weapons designed for war to maximize harm. They're not meant to be in the hands of civilians,\" Hashmi says. \"These are common sense policies that save lives and that reflect the will of the people that we serve.\"",
