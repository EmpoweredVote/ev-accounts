# Dependencies
node_modules/
backend/node_modules/

# Build outputs
dist/
backend/dist/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code — ignore everything except skills and agents
.claude/*
!.claude/skills/
!.claude/agents/

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Vitest
.vitest-cache/

# Supabase local
supabase/.branches/
supabase/.temp/

# Stance research and topic draft outputs (keep dirs via .gitkeep)
# Per-run review CSVs live in dated subdirs too, so match recursively — keep
# markdown summaries/benchmarks and debate-turn source transcripts tracked.
backend/data/stance-research/*.csv
backend/data/stance-research/**/*.csv
backend/data/topic-drafts/*.json

# Coverage tracker data — version-controlled source of truth.
# (Overrides the broad `coverage/` test-output rule above, which otherwise
# matches data/coverage/ by directory name.)
!backend/data/coverage/

# TIGER/Line shapefiles downloaded by boundary loader scripts
backend/tl_2024_*/
backend/tl_2024_*.zip
backend/.tmp-tiger-*/

# Python — validator script runtime artifacts
__pycache__/
*.pyc
*.pyo
.venv/
*.venv
backend/.tmp-legislators-current.yaml

# Playwright MCP session artifacts (screenshots / page snapshots)
.playwright-mcp/
backend/.tmp-national-cd119/

# One-shot migration apply/verify helpers & scratch (not durable record)
backend/scripts/_*
backend/migrations/_*.sql

# Stance-research working scratch (chunked SQL, agent prompts, wave topic dumps)
backend/data/stance-research/_*
backend/data/stance-research/**/_*
backend/data/stance-research/agent_prompt_*.txt
backend/data/stance-research/agent-prompt-*.txt
backend/data/stance-research/wave*
# Pipeline-generated working artifacts (regenerable): audit QA bundles + OTR transcript dumps
backend/data/stance-research/*.bundle.json
backend/data/stance-research/**/*.bundle.json
backend/data/stance-research/otr-transcripts/

# Per-rep stance-researcher agent memory (scratch; MEMORY.md stays tracked)
backend/.claude/agent-memory/politician-stance-researcher/stance_*.md

# Nested agent scratch when researchers run from a subdir cwd (.claude/* is root-anchored, so it misses these)
backend/data/stance-research/.claude/

# Other AI/agent tool scratch dirs (mirror of the .claude/ handling above)
.agents/
.codex/
.superpowers/

# CDK synth output (build artifact; infra/node_modules already covered by node_modules/)
infra/cdk.out/

# One-off generated analysis report (scratch, not a durable record)
bug_analysis_report.html

# GSD per-session active workstream pointer (local only)
.planning/active-workstream

# stance-quote validator fetch cache (regenerable)
backend/data/stance-research/*/.qcache/

# OLIS legislator roster cache (regenerable, 1.6MB)
backend/data/stance-research/or-bend-stateleg/.olis-legislators.json

# Editor/tooling backups. The `.env` rule above is an EXACT match and does not
# cover `.env.bak`, which sat untracked in the working tree holding live
# credentials (found 2026-07-26). With several sessions committing in this repo,
# a single `git add -A` would have published them. Never committed — verified
# across all refs — so this rule is prevention, not remediation.
*.bak

# Headshot pipeline working images (regenerable; the canonical copies live in the
# politician_photos Storage bucket). Contact sheets are review aids, not artifacts.
backend/data/stance-research/**/processed/
backend/data/stance-research/**/contact_sheets/

# Census Government Units Listing — redownloadable source data, ~10MB.
# https://www2.census.gov/programs-surveys/gus/datasets/2025/gov_units_2025.zip
backend/data/census-gov-units/
